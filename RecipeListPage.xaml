<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiRecipeApp.RecipeListPage"
             BackgroundColor="#7FC07953" AutomationProperties.IsInAccessibleTree="False"
             >

    <!-- 绝对布局，用来放悬浮按钮 -->
    <AbsoluteLayout>
        <!-- 主内容区域（可滚动页面），滚动触底时加载下一页 -->
        <ScrollView x:Name="mainScroll" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All"
                    Scrolled="OnMainScrollScrolled">
            <VerticalStackLayout Padding="15" Spacing="15">
                <!-- 顶部标题区域，点击按当前分类随机选一道菜 -->
                <Label Text="你好，美食家" FontSize="Title" FontAttributes="None" HorizontalOptions="Start">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTitleTapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <!-- 搜索框 -->
                <SearchBar x:Name="SearchBarRecipe" 
                           Placeholder="搜索想吃的美食"
                           TextChanged="OnSearchTextChanged"/>

                <!-- 分类标签横向滚动栏（可左右滑动，避免甜品等按钮被屏幕裁掉） -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10">
                        <Button x:Name="btnAll" Text="全部" BackgroundColor="#ffb84d" TextColor="Black" CornerRadius="20" Padding="12,5" Clicked="OnCategoryAll"/>
                        <Button x:Name="btnMeat" Text="荤菜" BackgroundColor="#eeeeee" TextColor="Black" CornerRadius="20" Padding="12,5" Clicked="OnCategoryMeat"/>
                        <Button x:Name="btnVegetable" Text="素菜" BackgroundColor="#eeeeee" TextColor="Black" CornerRadius="20" Padding="12,5" Clicked="OnCategoryVegetable"/>
                        <Button x:Name="btnStaple" Text="主食" BackgroundColor="#eeeeee" TextColor="Black" CornerRadius="20" Padding="12,5" Clicked="OnCategoryStaple"/>
                        <Button x:Name="btnSoup" Text="汤品" BackgroundColor="#eeeeee" TextColor="Black" CornerRadius="20" Padding="12,5" Clicked="OnCategorySoup"/>
                        <Button x:Name="btnDessert" Text="甜品" BackgroundColor="#eeeeee" TextColor="Black" CornerRadius="20" Padding="12,5" Clicked="OnCategoryDessert"/>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- 双列网格菜谱卡片（分页增量加载：外层 ScrollView 滚动触底时加载下一页） -->
                <CollectionView x:Name="RecipeCollectionView" ItemsSource="{Binding RecipeList}">
                    <CollectionView.EmptyView>
                        <Label Text="暂无菜谱，点右下角 + 添加" TextColor="#999999" HorizontalOptions="Center" Margin="0,60,0,0"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Span="2" Orientation="Vertical"
                                         VerticalItemSpacing="12"
                                         HorizontalItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- 不启用 Shadow：Android 上大量实时阴影是滚动卡顿主因 -->
                            <Border Margin="5" Padding="0" StrokeShape="RoundRectangle 12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                       Tapped="OnCardTapped"
                                       CommandParameter="{Binding}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="0">
                                    <!-- 菜品图片：优先缩略图（DisplayImage 自动回退原图，兼容老菜谱） -->
                                    <Image Source="{Binding DisplayImage}"
                                           WidthRequest="180" HeightRequest="140"
                                           Aspect="AspectFill"
                                           BackgroundColor="#eeeeee"/>
                                    <!-- 底部文字区域 -->
                                    <VerticalStackLayout Padding="10" Spacing="4">
                                        <Label Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold"/>
                                        <!--<Label Text="{Binding Category, StringFormat='分类：{0}'}" FontSize="Small"/>
                                        <Label Text="{Binding DurationMinutes, StringFormat='耗时：{0} 分钟'}" FontSize="Small"/>-->
                                        <!-- 删除按钮 -->
                                        <!--<Button Text="删除" BackgroundColor="#ff4444" WidthRequest="60" Padding="3,4"
                    Clicked="OnDeleteRecipeClicked" CommandParameter="{Binding}" HorizontalOptions="End"/>-->
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ✅ 右下角悬浮加号按钮 -->
        <Button Text="+" 
                BackgroundColor="#ff782b" 
                TextColor="White"
                FontSize="24"
                WidthRequest="60" HeightRequest="60"
                CornerRadius="30"               
                Clicked="OnAddRecipeClicked"
                AbsoluteLayout.LayoutBounds="0.92,0.92,60,60"
                AbsoluteLayout.LayoutFlags="PositionProportional"/>

        <!-- ✅ 右上角菜单按钮 -->
        <Button x:Name="btnMenu" Text="⋮"
                FontSize="26"
                TextColor="#333333"
                BackgroundColor="Transparent"
                WidthRequest="44" HeightRequest="44"
                Clicked="OnMenuClicked"
                AbsoluteLayout.LayoutBounds="1,0,44,44"
                AbsoluteLayout.LayoutFlags="PositionProportional"/>

        <!-- 菜单浮层（点击外部关闭） -->
        <Grid x:Name="menuOverlay" IsVisible="False"
              BackgroundColor="#40000000"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuOverlayTapped"/>
            </Grid.GestureRecognizers>
            <Border Margin="0,52,8,0" Padding="0" WidthRequest="190"
                    HorizontalOptions="End" VerticalOptions="Start"
                    BackgroundColor="White" Stroke="#dddddd" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">
                <Border.Shadow>
                    <Shadow Brush="#33000000" Offset="0,2" Radius="8"/>
                </Border.Shadow>
                <VerticalStackLayout>
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="👤" FontSize="20"/>
                        <Label Text="个人中心" Grid.Column="1" FontSize="Medium" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuItemProfile"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#eeeeee"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </AbsoluteLayout>
</ContentPage>
